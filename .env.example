# LegalServer API Configuration
LEGALSERVER_BASE_URL=https://yourdomain.legalserver.org
LEGALSERVER_BEARER_TOKEN=YourLegalServerBearerTokenAPIKey
LEGALSERVER_TIMEOUT_MS=30000
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3001
MCP_ALLOWED_HOSTS=legalserver-mcp,localhost,127.0.0.1
MCP_SHARED_SECRET=
MCP_SHARED_SECRET_HEADER=x-legalserver-mcp-secret
LEGALSERVER_USER_EMAIL_HEADER=x-legalserver-user-email
LEGALSERVER_CURRENT_USER_EVENTS_REPORT_URL=
LEGALSERVER_CURRENT_USER_TASKS_REPORT_URL=
LEGALSERVER_CURRENT_USER_MATTERS_REPORT_URL=
MATTER_CURRENT_USER_CACHE_TTL_MS=60000
MATTER_CURRENT_USER_FETCH_CONCURRENCY=4

# OCR Configuration — OFF BY DEFAULT
# Set DOCUMENT_OCR_PROVIDER=openai to enable OCR for scanned PDFs and PNG/JPEG/WebP
# documents. With `none`, those documents fail with error_code "ocr_unavailable"
# (412) and matter_search_document_text skips them into `warnings`.
#
# `openai` requires OPENAI_API_KEY; the server refuses to start without it. Page
# images go to api.openai.com directly and are never proxied. The `openrouter`
# and `vertex_gemini` providers were removed — setting either fails at boot.
#
# DOCUMENT_OCR_MODEL must be a vision-capable OpenAI model. Keep the full
# gpt-5.6-luna slug; the bare `gpt-5.6` alias routes to a different tier.
# DOCUMENT_OCR_MAX_PAGES bounds one document — each page is a separate API call.
#
# BEFORE YOU ENABLE THIS: it sends page images of scanned client documents to
# OpenAI. The server always sends `store: false` so they are not retained as
# retrievable objects, but that is NOT zero retention — that requires a Zero Data
# Retention agreement on YOUR OpenAI account, which no setting in this file can
# provide. ZDR also does not cover an image that OpenAI's CSAM classifier flags,
# which is retained for manual human review regardless. See README.md, "Zero Data
# Retention is your responsibility".
DOCUMENT_OCR_PROVIDER=none
DOCUMENT_OCR_MODEL=gpt-5.6-luna
DOCUMENT_OCR_MAX_PAGES=50
OPENAI_API_KEY=

# Optional Phase 3 manual validation targets
PHASE3_CONTACT_EMAIL=
PHASE3_USER_LOGIN=
PHASE3_ORGANIZATION_NAME=
PHASE3_CURRENT_USER_EMAIL=
PHASE3_TASK_DATE=
PHASE3_EVENT_DATE=
PHASE3_RANGE_START_DATE=
PHASE3_RANGE_END_DATE=
