# LegalServer API Configuration
LEGALSERVER_BASE_URL=https://yourdomain.legalserver.org
LEGALSERVER_BEARER_TOKEN=YourLegalServerBearerTokenAPIKey
LEGALSERVER_TIMEOUT_MS=30000
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3001
MCP_ALLOWED_HOSTS=legalserver-mcp,localhost,127.0.0.1
MCP_SHARED_SECRET=
MCP_SHARED_SECRET_HEADER=x-legalserver-mcp-secret
LEGALSERVER_USER_EMAIL_HEADER=x-legalserver-user-email
LEGALSERVER_CURRENT_USER_EVENTS_REPORT_URL=
LEGALSERVER_CURRENT_USER_TASKS_REPORT_URL=
LEGALSERVER_CURRENT_USER_MATTERS_REPORT_URL=
MATTER_CURRENT_USER_CACHE_TTL_MS=60000
MATTER_CURRENT_USER_FETCH_CONCURRENCY=4

# Optional Phase 2 OCR Configuration
# Set DOCUMENT_OCR_PROVIDER to enable OCR for scanned PDFs and supported images.
# Two providers are supported:
#   vertex_gemini — Vertex AI via Application Default Credentials (ADC). For local
#     development, either run `gcloud auth application-default login` or set
#     GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path. Requires
#     GOOGLE_CLOUD_PROJECT and a GCP project with the Vertex AI API enabled.
#   openrouter — OpenRouter's chat completions API (any vision-capable model,
#     default google/gemini-2.5-flash). Requires only OPENROUTER_API_KEY — no GCP
#     project/billing/service account needed.
DOCUMENT_OCR_PROVIDER=none
DOCUMENT_OCR_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
OPENROUTER_API_KEY=

# Optional Phase 3 manual validation targets
PHASE3_CONTACT_EMAIL=
PHASE3_USER_LOGIN=
PHASE3_ORGANIZATION_NAME=
PHASE3_CURRENT_USER_EMAIL=
PHASE3_TASK_DATE=
PHASE3_EVENT_DATE=
PHASE3_RANGE_START_DATE=
PHASE3_RANGE_END_DATE=
