# LegalServer API Configuration
LEGALSERVER_BASE_URL=https://yourdomain.legalserver.org
LEGALSERVER_BEARER_TOKEN=YourLegalServerBearerTokenAPIKey
LEGALSERVER_TIMEOUT_MS=30000
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3001
MCP_ALLOWED_HOSTS=legalserver-mcp,localhost,127.0.0.1
MCP_SHARED_SECRET=
MCP_SHARED_SECRET_HEADER=x-legalserver-mcp-secret
LEGALSERVER_USER_EMAIL_HEADER=x-legalserver-user-email
LEGALSERVER_CURRENT_USER_EVENTS_REPORT_URL=
LEGALSERVER_CURRENT_USER_TASKS_REPORT_URL=
LEGALSERVER_CURRENT_USER_MATTERS_REPORT_URL=
MATTER_CURRENT_USER_CACHE_TTL_MS=60000
MATTER_CURRENT_USER_FETCH_CONCURRENCY=4

# OCR Configuration — NOT SUPPORTED YET
# OCR is a planned future feature. It is not supported in this release.
#
# Leave DOCUMENT_OCR_PROVIDER=none. Scanned PDFs (no embedded text layer) and
# PNG/JPEG/WebP documents fail with error_code "ocr_unavailable" (412), and
# matter_search_document_text skips them and reports them in `warnings`.
#
# The variables below are reserved for that future release. The repo contains
# unreleased OpenAI provider scaffolding that is not run in production and not
# covered end to end by tests, so the server REFUSES TO START if
# DOCUMENT_OCR_PROVIDER is set to anything else — including a fully credentialed
# `openai`. The `openrouter` and `vertex_gemini` providers were removed; setting
# either now fails at boot with a message saying so.
#
# WHEN OCR SHIPS, ENABLING IT IS NOT JUST A CONFIG CHANGE. Scanned client
# documents get sent to OpenAI as page images. The server will always send
# `store: false` so they are not retained as retrievable objects, but that is NOT
# zero retention — that requires a Zero Data Retention agreement on YOUR OpenAI
# account, which no setting in this file can provide. See README.md, "OCR Is Not
# Supported Yet".
DOCUMENT_OCR_PROVIDER=none
DOCUMENT_OCR_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Optional Phase 3 manual validation targets
PHASE3_CONTACT_EMAIL=
PHASE3_USER_LOGIN=
PHASE3_ORGANIZATION_NAME=
PHASE3_CURRENT_USER_EMAIL=
PHASE3_TASK_DATE=
PHASE3_EVENT_DATE=
PHASE3_RANGE_START_DATE=
PHASE3_RANGE_END_DATE=
